{
  "name": "zekel-games-workspace",
  "private": true,
  "type": "module",
  "description": "Zekel Games' own board games as zekel game modules, one package each, built on @zekel/game-kit.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -b packages/* && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "tool": "tsx scripts/dev.ts",
    "harness": "tsx scripts/dev.ts ai-harness",
    "balance-dashboard": "tsx scripts/dev.ts balance-dashboard",
    "engine-bot": "tsx scripts/dev.ts engine-bot",
    "human-seat-sweep": "tsx scripts/dev.ts human-seat-sweep",
    "desync-bot": "tsx scripts/dev.ts desync-bot",
    "assistant-bot": "tsx scripts/dev.ts assistant-bot",
    "llm-bot": "tsx scripts/dev.ts llm-bot",
    "relay-bot": "tsx scripts/dev.ts relay-bot",
    "integration-bot": "tsx scripts/dev.ts integration-bot",
    "verify-hunt": "tsx scripts/dev.ts verify-hunt",
    "verify-lint": "tsx scripts/dev.ts verify-lint",
    "check-summaries": "tsx scripts/dev.ts check-summaries",
    "choice-catalog": "tsx scripts/dev.ts choice-catalog"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@zekel/8-bit-demon-hunter": "workspace:*",
    "@zekel/adventurer-olympics": "workspace:*",
    "@zekel/cybernoir-2127": "workspace:*",
    "@zekel/dev": "^0.1.1",
    "@zekel/fractured-fist": "workspace:*",
    "@zekel/game-kit": "^0.1.0",
    "@zekel/mcp": "^0.1.1",
    "@zekel/neither-guts-nor-gears": "workspace:*",
    "@zekel/sweetlands-imperium": "workspace:*",
    "@zekel/warble-way-galaxy": "workspace:*",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
