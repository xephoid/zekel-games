{
  "name": "@zekel/sweetlands-imperium",
  "version": "0.1.2",
  "description": "Sweetlands Imperium, a Zekel Games board game, as a game module for the zekel MCP server.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xephoid/zekel-games.git",
    "directory": "packages/sweetlands-imperium"
  },
  "homepage": "https://github.com/xephoid/zekel-games#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "default": "./dist/dev/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@zekel/game-kit": "^0.1.0",
    "@zekel/dev": "^0.1.1"
  },
  "peerDependenciesMeta": {
    "@zekel/dev": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zekel/game-kit": "^0.1.0",
    "@zekel/dev": "^0.1.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
