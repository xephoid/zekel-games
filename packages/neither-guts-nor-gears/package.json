{
  "name": "@zekel/neither-guts-nor-gears",
  "version": "0.1.4",
  "description": "Neither Guts nor Gears, a Zekel Games board game: its rules as a game module for the zekel MCP server, and its rulebook page for Zekel Universe.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xephoid/zekel-games.git",
    "directory": "packages/neither-guts-nor-gears"
  },
  "homepage": "https://github.com/xephoid/zekel-games#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "default": "./dist/dev/index.js"
    },
    "./glue": {
      "types": "./dist/glue/index.d.ts",
      "default": "./dist/glue/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "rules",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@zekel/game-kit": "^0.1.0",
    "@zekel/dev": "^0.1.1",
    "@zekel/glue-kit": "^0.1.0",
    "@zekel/wire-types": "^0.1.0",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@zekel/dev": {
      "optional": true
    },
    "@zekel/glue-kit": {
      "optional": true
    },
    "@zekel/wire-types": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zekel/game-kit": "^0.1.0",
    "@zekel/dev": "^0.1.2",
    "@zekel/glue-kit": "^0.1.0",
    "@zekel/wire-types": "^0.1.0",
    "react": "^18.3.1",
    "@types/react": "^18.3.12"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
